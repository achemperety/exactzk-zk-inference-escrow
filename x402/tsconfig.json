{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@x402/core": [
        "vendor/x402/typescript/packages/core/src/index.ts"
      ],
      "@x402/core/*": [
        "vendor/x402/typescript/packages/core/src/*/index.ts"
      ],
      "@x402/evm": [
        "vendor/x402/typescript/packages/mechanisms/evm/src/index.ts"
      ],
      "@x402/evm/*": [
        "vendor/x402/typescript/packages/mechanisms/evm/src/*/index.ts"
      ]
    }
  },
  "include": [
    "client/**/*.ts"
  ]
}
