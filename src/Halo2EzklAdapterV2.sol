pragma solidity ^0.8.24;

import {IProofVerifier} from "./IProofVerifier.sol";

/// @title Halo2EzklAdapterV2
/// @notice Adapter for verifier contracts generated by EZKL (Halo2, KZG, BN254), version 2.
/// @dev Version 2 differs from `Halo2EzklAdapter` (deployed, and kept unchanged because registry
/// entries pin its code) in one rule: it never answers `false` for a verifier that may only have run
/// out of gas. A generated verifier rejects by reverting with no data, which looks the same as
/// running out of gas. If the verifier did not accept and no more than 1/16 of the gas this call
/// started with is left, the adapter reverts with `TargetGasExhausted` instead of returning
/// `false`; a check reads that revert as Unverifiable. Exhaustion `d` all-gas calls below the
/// adapter leaves about `(1 - (63/64)^d)` of the gas unspent: 1.1% at d = 1 (the verifier itself),
/// 3.0% at 2 (the verifier calling a precompile), 4.5% at 3, 6.0% at 4, all under 1/16 (6.25%). A
/// precompile given bad input also consumes all the gas it is given. A genuine rejection leaves
/// more than 1/16 when the entry's allowance is at least 1.10 times the verifier's valid path.
/// Verifiers that nest calls deeper than 4 below this adapter must not be registered with it.
///
/// @dev Everything that is specific to that proof system lives here and nowhere else:
/// - the verifier's interface, `verifyProof(bytes proof, uint256[] instances) returns (bool)`;
/// - the layout of the public inputs: one input commitment per lane, then each lane's outputs,
///   lane after lane, every value one field element;
/// - the field: a commitment or an output word that is not below the BN254 scalar modulus is
///   rejected here, so two different 32-byte values can never stand for the same field element;
/// - the way a generated verifier fails: it may return false or revert with no data; both become
///   `false` if gas was left to spare, and a `TargetGasExhausted` revert otherwise.
/// `outputSize` is therefore 32 bytes times the number of outputs per lane.
///
/// The adapter holds no state. `target` is called with STATICCALL.
contract Halo2EzklAdapterV2 is IProofVerifier {
    /// @notice The verifier did not accept and the call left too little gas to tell a rejection
    /// from running out of gas. Nothing was decided about the proof.
    error TargetGasExhausted(uint256 gasLeft, uint256 gasAtStart);

    /// @dev keccak256("halo2-kzg-bn254/ezkl")
    bytes32 public constant PROOF_SYSTEM = keccak256("halo2-kzg-bn254/ezkl");

    /// @inheritdoc IProofVerifier
    function proofSystem() external pure returns (bytes32) {
        return PROOF_SYSTEM;
    }

    /// @inheritdoc IProofVerifier
    /// @dev Reverts with `TargetGasExhausted` if `target` did not accept and no more than 1/16 of
    /// the gas this call started with is left after it. Never reverts otherwise.
    function verify(
        address target,
        uint32 outputSize,
        bytes32[] calldata commitments,
        bytes calldata outputs,
        bytes calldata proof
    ) external view returns (bool ok) {
        uint256 gasAtStart = gasleft();
        uint256 lanes = commitments.length;
        if (lanes == 0 || outputSize % 32 != 0 || outputs.length != lanes * uint256(outputSize)) return false;

        // Every public input must be a canonical field element.
        uint256 commitmentsStart;
        uint256 outputsStart;
        assembly ("memory-safe") {
            commitmentsStart := commitments.offset
            outputsStart := outputs.offset
        }
        if (!_canonical(commitmentsStart, lanes << 5) || !_canonical(outputsStart, outputs.length)) return false;

        assembly ("memory-safe") {
            // Build verifyProof(bytes,uint256[]) calldata in free memory:
            //   selector | 0x40 | offset of instances | proof length | proof, padded |
            //   instance count | commitments | outputs
            let ptr := mload(0x40)
            let proofPadded := and(add(proof.length, 0x1f), not(0x1f))
            let commitmentBytes := shl(5, lanes)

            mstore(ptr, shl(224, 0x1e8e1e13)) // verifyProof(bytes,uint256[])
            mstore(add(ptr, 0x04), 0x40)
            mstore(add(ptr, 0x24), add(0x60, proofPadded))
            mstore(add(ptr, 0x44), proof.length)
            let cursor := add(ptr, 0x64)
            // Defensive: this memory is unused so far and therefore already zero.
            if proofPadded { mstore(add(cursor, sub(proofPadded, 0x20)), 0) }
            calldatacopy(cursor, proof.offset, proof.length)

            cursor := add(cursor, proofPadded)
            mstore(cursor, add(lanes, shr(5, outputs.length)))
            cursor := add(cursor, 0x20)
            calldatacopy(cursor, commitments.offset, commitmentBytes)
            cursor := add(cursor, commitmentBytes)
            calldatacopy(cursor, outputs.offset, outputs.length)
            cursor := add(cursor, outputs.length)

            // Defensive: a result is accepted only if exactly 32 bytes came back, which
            // overwrites this word in full.
            mstore(0x00, 0)
            let success := staticcall(gas(), target, ptr, sub(cursor, ptr), 0x00, 0x20)
            ok := and(success, and(eq(returndatasize(), 0x20), eq(mload(0x00), 1)))
        }
        if (!ok) {
            uint256 gasLeft = gasleft();
            if (gasLeft <= gasAtStart / 16) revert TargetGasExhausted(gasLeft, gasAtStart);
        }
    }

    /// @dev True if every 32-byte word of `calldata[start .. start + length)` is below the field
    /// modulus. `length` is a multiple of 32. Eight words per pass, then the rest one at a time.
    /// Kept in its own function so the loop runs with few live variables.
    function _canonical(uint256 start, uint256 length) private pure returns (bool ok) {
        assembly ("memory-safe") {
            // A local, not the contract constant: the constant is reached through a call.
            let r := 0x30644e72e131a029b85045b68181585d2833e84879b9709143e1f593f0000001
            ok := 1
            let end := add(start, length)
            let p := start
            for { let end8 := add(start, and(length, not(0xff))) } lt(p, end8) { p := add(p, 0x100) } {
                ok := and(
                    ok,
                    and(
                        and(
                            and(lt(calldataload(p), r), lt(calldataload(add(p, 0x20)), r)),
                            and(lt(calldataload(add(p, 0x40)), r), lt(calldataload(add(p, 0x60)), r))
                        ),
                        and(
                            and(lt(calldataload(add(p, 0x80)), r), lt(calldataload(add(p, 0xa0)), r)),
                            and(lt(calldataload(add(p, 0xc0)), r), lt(calldataload(add(p, 0xe0)), r))
                        )
                    )
                )
            }
            for {} lt(p, end) { p := add(p, 0x20) } { ok := and(ok, lt(calldataload(p), r)) }
        }
    }
}
